  {
    "id": "pg-write",
    "type": "postgresql",
    "z": "tab-ingest",
    "name": "write to timescaledb",
    "query": "",
    "postgreSQLConfig": "pgconfig",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 640,
    "y": 140,
    "wires": [
      []
    ]
  },
  {
    "id": "fn-rule",
    "type": "function",
    "z": "tab-ingest",
    "name": "relay rule with hysteresis",
    "func": "const relays = flow.get('relays') || {};\nconst rules = global.get('rules');\nconst command = rules.react(relays, msg.reading, rules.thresholds);\nflow.set('relays', relays);\nreturn command;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 640,
    "y": 260,
    "wires": [
      [
        "out-commands"
      ]
    ]
  },
  {
    "id": "fn-track",
    "type": "function",
    "z": "tab-ingest",
    "name": "remember relay state",
    "func": "const relays = flow.get('relays') || {};\nglobal.get('rules').track(relays, msg.state);\nflow.set('relays', relays);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 640,
    "y": 320,
    "wires": [
      []
    ]
  },
